// Assets-only Worker for the static Vite build: there is no Worker script. The SPA fallback serves
// index.html for every path that matches no file, which is how /liquidations and /how-it-works load.
{
  "name": "lending-poc",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
